<style>
  /* ===== Màn hình gộp nhiều dịch vụ ===== */
  .mu{--pad:16px;--gap:10px;display:flex;flex-direction:column;gap:var(--gap);width:100%;height:100%;box-sizing:border-box;padding:var(--pad) calc(var(--pad) + 4px);font-family:'Inter','Helvetica Neue',Arial,sans-serif;color:#000;background:#fff;}
  .mu *{box-sizing:border-box;}
  .mu-rows{flex:1;min-height:0;display:flex;flex-direction:column;gap:var(--gap);}
  .mu-row{flex:1 1 0;min-height:0;display:flex;align-items:stretch;border:3px solid #000;border-radius:12px;overflow:hidden;}
  .mu-name{flex:none;width:150px;background:#000;color:#fff;display:flex;flex-direction:column;justify-content:center;gap:6px;padding:8px 14px;}
  .mu-name .n{font-size:24px;font-weight:900;letter-spacing:.5px;line-height:1;white-space:nowrap;}
  .mu-name .p{align-self:flex-start;font-size:12px;font-weight:800;letter-spacing:1px;border:2px solid #fff;border-radius:999px;padding:2px 8px;text-transform:uppercase;}
  .mu-name .w{align-self:flex-start;font-size:11px;font-weight:900;background:#fff;color:#000;border-radius:4px;padding:2px 5px;white-space:nowrap;}
  .mu-name .fr{font-size:11px;font-weight:700;white-space:nowrap;display:none;}
  .mu-m{flex:1 1 0;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:6px;padding:8px 16px;}
  .mu-m + .mu-m{border-left:2px solid #000;}
  .mu-top{display:flex;align-items:baseline;gap:8px;white-space:nowrap;}
  .mu-lbl{flex:1;min-width:0;font-size:14px;font-weight:900;letter-spacing:1px;text-transform:uppercase;overflow:hidden;text-overflow:ellipsis;}
  .mu-pct{flex:none;font-size:36px;font-weight:900;letter-spacing:-1px;line-height:.9;}
  .mu-pct small{font-size:.5em;letter-spacing:0;}
  .mu-full .mu-pct{text-decoration:underline;text-decoration-thickness:3px;}
  .mu-bar{position:relative;height:18px;border:2px solid #000;border-radius:6px;}
  .mu-fill{position:absolute;left:0;top:0;bottom:0;background:#000;border-radius:3px 0 0 3px;}
  .mu-fill.f100{border-radius:3px;}
  .mu-pace{position:absolute;top:-6px;bottom:-6px;width:3px;margin-left:-1px;background:#000;border:1px solid #fff;outline:1px solid #000;}
  .mu-rs{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .mu-rs b{font-weight:900;}
  .mu-msg{flex:1;display:flex;flex-direction:column;justify-content:center;padding:8px 16px;gap:4px;}
  .mu-msg .b{font-size:20px;font-weight:900;}
  .mu-msg .s{font-size:13px;}
  /* Dải Full reset (Claude) */
  .mu-fr{flex:none;display:flex;align-items:center;gap:14px;height:46px;border:3px solid #000;border-radius:12px;padding:0 14px 0 0;overflow:hidden;white-space:nowrap;}
  .mu-fr .t{align-self:stretch;display:flex;align-items:center;gap:8px;background:#000;color:#fff;padding:0 14px;font-size:14px;font-weight:900;letter-spacing:1px;}
  .mu-fr .t i{font-style:normal;font-weight:700;letter-spacing:0;font-size:12px;}
  .mu-fr .big{font-size:24px;font-weight:900;}
  .mu-fr .sp{flex:1;}
  .mu-fr .e{font-size:14px;}.mu-fr .e b{font-size:18px;font-weight:900;}
  .mu-fr.urgent{background:#000;color:#fff;}
  .mu-fr.urgent .t{border-right:2px solid #fff;}
  .mu .S{display:none;}

  /* ===== Nửa ngang (800×240) ===== */
  .sz-hh .mu{--pad:8px;--gap:6px;}
  .sz-hh .mu .cu-hd,.sz-hh .mu-fr{display:none;}
  .sz-hh .mu-row{border-width:2px;border-radius:8px;}
  .sz-hh .mu-name{width:116px;padding:4px 10px;gap:3px;}
  .sz-hh .mu-name .n{font-size:17px;}.sz-hh .mu-name .p{display:none;}.sz-hh .mu-name .fr{display:block;}
  .sz-hh .mu-m{padding:3px 12px;gap:3px;}
  .sz-hh .mu-lbl{font-size:11px;}.sz-hh .mu-pct{font-size:22px;}
  .sz-hh .mu-bar{height:11px;border-width:2px;border-radius:4px;}.sz-hh .mu-pace{top:-4px;bottom:-4px;width:2px;}
  .sz-hh .mu-rs{font-size:11px;}
  .sz-hh .mu .L{display:none;}.sz-hh .mu .S{display:inline;}

  /* ===== Nửa dọc (400×480) ===== */
  .sz-hv .mu{--pad:10px;--gap:8px;}
  .sz-hv .mu .cu-title{font-size:16px;letter-spacing:.5px;}.sz-hv .mu .cu-upd{font-size:12px;}
  .sz-hv .mu-row{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto 1fr;border-width:2px;border-radius:10px;}
  .sz-hv .mu-name{grid-column:1 / 3;width:auto;flex-direction:row;align-items:center;justify-content:flex-start;padding:4px 10px;gap:8px;}
  .sz-hv .mu-msg{grid-column:1 / 3;padding:4px 10px;}.sz-hv .mu-msg .b{font-size:15px;}.sz-hv .mu-msg .s{font-size:11px;}
  .sz-hv .mu-name .n{font-size:16px;}.sz-hv .mu-name .p{font-size:10px;padding:1px 6px;border-width:1px;}
  .sz-hv .mu-m{padding:4px 9px;gap:4px;}
  .sz-hv .mu-m + .mu-m{border-left:1px solid #000;}
  .sz-hv .mu-lbl{font-size:10px;letter-spacing:.3px;}.sz-hv .mu-pct{font-size:24px;}
  .sz-hv .mu-bar{height:11px;border-radius:4px;}.sz-hv .mu-pace{top:-4px;bottom:-4px;width:2px;}
  .sz-hv .mu-rs{font-size:10px;}
  .sz-hv .mu .L{display:none;}.sz-hv .mu .S{display:inline;}
  .sz-hv .mu-fr{height:auto;flex-wrap:wrap;gap:2px 8px;padding:0 8px 4px 0;border-width:2px;border-radius:10px;}
  .sz-hv .mu-fr .t{align-self:auto;width:100%;padding:3px 8px;font-size:12px;}.sz-hv .mu-fr .big{font-size:17px;padding-left:8px;}.sz-hv .mu-fr .sp{display:none;}.sz-hv .mu-fr .e{font-size:11px;}.sz-hv .mu-fr .e b{font-size:13px;}

  /* ===== 1/4 (400×240) ===== */
  .sz-q .mu{--pad:6px;--gap:5px;}
  .sz-q .mu .cu-hd,.sz-q .mu-fr,.sz-q .mu-rs{display:none;}
  .sz-q .mu-row{border-width:2px;border-radius:7px;}
  .sz-q .mu-name{width:78px;padding:2px 7px;gap:2px;}
  .sz-q .mu-name .n{font-size:13px;}.sz-q .mu-name .p,.sz-q .mu-name .w{display:none;}.sz-q .mu-name .fr{display:block;font-size:9px;}
  .sz-q .mu-m{padding:2px 7px;gap:2px;}
  .sz-q .mu-lbl{font-size:9px;letter-spacing:.3px;}.sz-q .mu-pct{font-size:17px;}
  .sz-q .mu-bar{height:8px;border-width:1px;border-radius:3px;}.sz-q .mu-pace{top:-3px;bottom:-3px;width:2px;}
  .sz-q .mu-msg .b{font-size:12px;}.sz-q .mu-msg .s{display:none;}
</style>
